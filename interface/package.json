{
  "name": "v1simple-interface",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bash ../tools/compress_web_assets.sh",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/deploy.js",
    "deploy:built": "node scripts/deploy.js",
    "prepare": "svelte-kit sync",
    "lint": "eslint . && svelte-check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.20.5",
    "daisyui": "^5.7.50",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.30",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0"
  }
}
