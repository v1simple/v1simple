#pragma once
#include "Arduino.h"
#include "WiFi.h"

@SLOT_METADATA@

// Storage is already ready and one ordinary saved network is configured. These
// boundaries do not simulate persistence; the tests exercise connection ownership.
struct V1Settings {
    bool wifiClientEnabled = true;
    String wifiClientSSID = "Saved";
    WifiStaSlot wifiStaSlots[kWifiStaSlotCount];
    bool hasConfiguredWifiStaSlot() const {
        for (const auto& slot : wifiStaSlots) {
            if (slot.isConfigured()) return true;
        }
        return false;
    }
};

class SettingsManager {
  public:
    V1Settings value;
    struct PersistResult { bool success; };
    bool enabledWriteSucceeds = true;
    bool credentialWriteSucceeds = true;
    bool clearSucceeds = true;
    bool resolveSucceeds = true;
    std::function<void()> beforeMark;
    PersistResult setWifiClientEnabled(bool enabled) {
        stationEffects.push_back(enabled ? "enabled:1" : "enabled:0");
        if (enabledWriteSucceeds) value.wifiClientEnabled = enabled;
        return {enabledWriteSucceeds};
    }
    bool clearWifiStaSlot(size_t index) {
        stationEffects.push_back("clear:" + std::to_string(index));
        if (clearSucceeds) value.wifiStaSlots[index].ssid = "";
        return clearSucceeds;
    }
    bool clearWifiClientCredentials() {
        stationEffects.push_back("forget");
        if (clearSucceeds) {
            value.wifiClientEnabled = false;
            value.wifiClientSSID = "";
            for (auto& slot : value.wifiStaSlots) slot.ssid = "";
        }
        return clearSucceeds;
    }
    uint32_t recoveredRevision = 0;
    uint32_t recoveryRevision() const { return recoveredRevision; }
    bool pendingRecovery = false;
    bool recoveryPending() const { return pendingRecovery; }
    int credentialWrites = 0;
    int markCalls = 0;
    size_t markedIndex = kWifiStaSlotCount;
    const V1Settings& get() const { return value; }
    bool resolveStorageTransactionsForMutation() { stationEffects.push_back("storage:resolve"); return resolveSucceeds; }
    String getWifiStaSlotPassword(size_t index, bool* failed = nullptr) const {
        if (failed) *failed = false;
        stationEffects.push_back("password:" + std::to_string(index));
        return "password";
    }
    String getWifiClientPassword() const { stationEffects.push_back("password:legacy"); return "password"; }
    bool setWifiStaSlotCredentials(size_t index, const String& ssid, const String&, const String&, uint8_t) {
        stationEffects.push_back("slot:" + std::to_string(index));
        ++credentialWrites;
        if (credentialWriteSucceeds) value.wifiStaSlots[index].ssid = ssid;
        return credentialWriteSucceeds;
    }
    bool setWifiClientCredentials(const String&, const String&) {
        ++credentialWrites;
        return true;
    }
    bool markWifiStaSlotConnected(size_t index) {
        if (beforeMark) beforeMark();
        stationEffects.push_back("recency:" + std::to_string(index));
        ++markCalls;
        markedIndex = index;
        return true;
    }
};
