#!/usr/bin/env bash
# Privacy gate for commit messages.
#
# Install:  ./scripts/setup-hooks.sh
# The pre-push hook independently scans every commit message before publication.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
PRIVACY_CHECK="$ROOT/scripts/check_public_snapshot_privacy.py"
[ -f "$PRIVACY_CHECK" ] || {
  echo "commit-message privacy check is unavailable; refusing to commit" >&2
  exit 1
}

exec python3 "$PRIVACY_CHECK" --message-file "$1"
